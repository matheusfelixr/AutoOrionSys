      overflow: hidden;
    }

    .shell-body {
      flex: 1;
      overflow-y: auto;
      background: var(--ui-color-bg-subtle);
    }

    /* Topbar */
    .shell-topbar {
      height: 56px;
      background: #0d0f18;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
      flex-shrink: 0;
    }

    .topbar-left {
      display: flex;
