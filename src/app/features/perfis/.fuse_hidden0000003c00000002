      <div class="crud-sort-header">
        <button class="crud-sort-btn" (click)="toggleSort('nome')">Nome {{ sortIcon('nome') }}</button>
        <button class="crud-sort-btn" (click)="toggleSort('totalUsuarios')">Usuários {{ sortIcon('totalUsuarios') }}</button>
